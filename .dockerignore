# Git - prevents conflicts when initializing customer repos
.git
# Keep .gitignore - it's needed in the container for proper git commits

# Build artifacts (regenerated by Claude)
dist/
build/

# Node modules (installed fresh via npm ci)
node_modules/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Local development
.env.local
.env.*.local

# GitLab CI (not needed in container)
.gitlab-ci.yml

# Documentation (not needed in runtime)
*.md
!README.md

# Test files
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/

# Temporary files
.DS_Store
Thumbs.db
*.tmp
*.temp

