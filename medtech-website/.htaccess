# MedTech For Solutions — pretty URL settings
# Every page lives at <slug>/index.html and is served at the clean URL /<slug>/

Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. /path/index.html  ->  /path/   (hide index.html)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# 2. /page.html  ->  /page/   (hide .html extensions)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[?\s]
RewriteRule ^(.+)\.html$ /$1/ [R=301,L]

# 3. force trailing slash on directory URLs  (/about -> /about/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 4. serve /<slug>/index.html for clean /<slug>/ requests
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>
